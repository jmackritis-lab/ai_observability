{
  "title": "Claude Code — My Usage",
  "uid": "claude-code-me",
  "tags": [
    "claude-code",
    "otel",
    "self-service",
    "transparency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Session Explorer",
      "type": "link",
      "url": "/d/claude-code-sessions",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Usage Audit",
      "type": "link",
      "url": "/d/claude-code-audit",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "user_email",
        "label": "Engineer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_cost_usage_USD_total, user_email)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "My spend (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{user_email=\"$user_email\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Team average per engineer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total[$__range])) / count(count by (user_email) (present_over_time(claude_code_session_count_total[$__range])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Total spend divided by number of active engineers over the same range — context, not a target."
    },
    {
      "type": "stat",
      "title": "My sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "count(present_over_time(claude_code_session_count_total{user_email=\"$user_email\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "My active hours",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_active_time_seconds_total{user_email=\"$user_email\"}[$__range])) / 3600",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "My commits",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_commit_count_total{user_email=\"$user_email\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "My cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * sum(increase(claude_code_token_usage_tokens_total{user_email=\"$user_email\", type=\"cacheRead\"}[$__range])) / sum(increase(claude_code_token_usage_tokens_total{user_email=\"$user_email\", type=~\"input|cacheRead|cacheCreation\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Higher is cheaper. Long-running sessions on one task keep the cache warm; many short sessions do not."
    },
    {
      "type": "timeseries",
      "title": "My spend per day by project",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (project) (increase(claude_code_cost_usage_USD_total{user_email=\"$user_email\"}[1d]))",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "My spend by model (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{user_email=\"$user_email\"}[$__range]))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "piechart",
      "title": "My spend by story (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (jira_story) (increase(claude_code_cost_usage_USD_total{user_email=\"$user_email\"}[$__range]))",
          "legendFormat": "{{jira_story}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "table",
      "title": "My sessions (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Spend"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (session_id, project, jira_epic, jira_story, model) (sum_over_time({service_name=\"claude-code\"} | user_email=\"$user_email\" |= \"claude_code.api_request\" | unwrap cost_usd [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "session_id": "Session",
              "project": "Project",
              "jira_epic": "Epic",
              "jira_story": "Story",
              "model": "Model",
              "Value #A": "Spend"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Spend",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "From api_request events. Copy a Session id into Session Explorer for the full timeline."
    },
    {
      "type": "table",
      "title": "My tool usage (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | user_email=\"$user_email\" |= \"claude_code.tool_result\" | tool_name != `` [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "tool_name": "Tool",
              "Value #A": "Calls"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Calls",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "My recent tool calls (name, success, duration — no content)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"} | user_email=\"$user_email\" |= \"claude_code.tool_result\"",
          "refId": "A"
        }
      ],
      "description": "Exactly what the audit trail holds about tool use: tool name, success, duration, decision source. With OTEL_LOG_TOOL_DETAILS=1 also the bash command line and file paths — never file contents."
    },
    {
      "type": "text",
      "title": "What this stack records about you — and what it does not",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {
        "mode": "markdown",
        "content": "**Recorded:** token counts and estimated cost per model; session count and duration; commits, PRs and lines changed; tool names, success/failure and duration; skill, agent, plugin and MCP server names; permission decisions; your Claude Code version and terminal; `project` / `jira.*` tags your launcher attaches; your account e-mail.\n\n**Not recorded (disabled in managed settings):** prompts, assistant responses, file contents, tool inputs/outputs beyond names and sizes, raw API request/response bodies.\n\nEverything on this page is derived from those counters and events. The same data feeds the team dashboards, aggregated. Session attribution is read once at `claude` startup from `OTEL_RESOURCE_ATTRIBUTES` — use `claude-attr` to launch so your work lands on the right epic."
      }
    }
  ],
  "description": "Per-engineer transparency view: your own spend, sessions, tools and exactly what the telemetry does and does not capture."
}
